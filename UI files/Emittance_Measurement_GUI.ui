}</string>
         </property>
         <property name="title">
          <string>Additional fit parameters</string>
         </property>
         <layout class="QGridLayout" name="gridLocalOptimizationSettings">
          <property name="horizontalSpacing">
           <number>12</number>
          </property>
          <property name="verticalSpacing">
           <number>6</number>
          </property>
          <item row="0" column="0">
           <layout class="QHBoxLayout" name="fitK1ScaleLabelHBox">
            <item>
             <widget class="QCheckBox" name="fit_quadrupole_strength_checkbox">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Fit effective K1₀ together with emittance and Twiss parameters.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="text">
               <string>Fit quadrupole strength</string>
              </property>
              <property name="checked">
               <bool>false</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QToolButton" name="fit_k1_scale_info_button">
              <property name="minimumSize">
               <size>
                <width>24</width>
                <height>24</height>
               </size>
              </property>
              <property name="maximumSize">
               <size>
                <width>24</width>
                <height>24</height>
               </size>
              </property>
              <property name="cursor">
               <cursorShape>PointingHandCursor</cursorShape>
              </property>
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Add the nominal quadrupole strength K1₀ as an extra fit parameter.&lt;/p&gt;&lt;p&gt;Without this option, the optimizer assumes that the measured/read K1 values are exactly correct.&lt;/p&gt;&lt;p&gt;With this option, the optimizer can compensate a mismatch between the readback K1 and the quadrupole strength used by the beam.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="styleSheet">
               <string notr="true">QToolButton#fit_k1_scale_info_button {
    border: 1px solid #888;
    border-radius: 11px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 0px;
    font-weight: bold;
}
QToolButton#fit_k1_scale_info_button:hover {
    background-color: #e6e6e6;
}</string>
              </property>
              <property name="text">
               <string>?</string>
              </property>
              <property name="toolButtonStyle">
               <enum>Qt::ToolButtonTextOnly</enum>
              </property>
              <property name="autoRaise">
               <bool>false</bool>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="1" column="0" colspan="2">
           <layout class="QHBoxLayout" name="fitMisalignmentHBox">
            <item>
             <widget class="QCheckBox" name="fit_quad_offset_checkbox">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Fit the scanned quadrupole's transverse offset (quad_dx0, quad_dy0) together with emittance and Twiss parameters, from how the beam centroid on each screen moves vs K1L.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="text">
               <string>Fit quad offset</string>
              </property>
              <property name="checked">
               <bool>false</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QToolButton" name="fit_quad_offset_info_button">
              <property name="minimumSize">
               <size>
                <width>24</width>
                <height>24</height>
               </size>
              </property>
              <property name="maximumSize">
               <size>
                <width>24</width>
                <height>24</height>
               </size>
              </property>
              <property name="cursor">
               <cursorShape>PointingHandCursor</cursorShape>
              </property>
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Fits the horizontal and vertical displacement of the scanned quadrupole relative to the beamline (Δx and Δy).&lt;/p&gt;&lt;p&gt;It uses how the beam centroid on each screen changes with K1L. Enable it only when those centroid measurements are reliable.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="styleSheet">
               <string notr="true">QToolButton#fit_quad_offset_info_button {
    border: 1px solid #888;
    border-radius: 11px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 0px;
    font-weight: bold;
}
QToolButton#fit_quad_offset_info_button:hover {
    background-color: #e6e6e6;
}</string>
              </property>
              <property name="text">
               <string>?</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="fit_quad_roll_checkbox">
              <property name="toolTip">
               <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Fit the scanned quadrupole's roll (quad_roll) together with emittance and Twiss parameters, from the x-y coupling (sigma_xy) on each screen vs K1L.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
              </property>
              <property name="text">
               <string>Fit quad roll (coupling)</string>
              </property>
              <property name="checked">
               <bool>false</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QToolButton" name="fit_quad_roll_info_button">
